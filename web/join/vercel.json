{
  "functions": {
    "api/mcsv/install.js": {
      "maxDuration": 300,
      "includeFiles": "artifacts/**"
    },
    "api/mcsv/artifact.js": {
      "includeFiles": "artifacts/**"
    }
  },
  "routes": [
    {
      "src": "^/(.*)$",
      "headers": {
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "^/downloads/VC-Mumla-Web-Join.apk$",
      "headers": {
        "Content-Type": "application/vnd.android.package-archive",
        "Content-Disposition": "attachment; filename=\"SleepyMumla.apk\""
      },
      "continue": true
    },
    {
      "src": "^/download$",
      "headers": {
        "Content-Type": "application/vnd.android.package-archive",
        "Content-Disposition": "attachment; filename=\"SleepyMumla.apk\""
      },
      "continue": true
    },
    {
      "src": "^/(?:lib(?:/.*)?|artifacts(?:/.*)?|api/.*\\.js|(?:AUTH_SETUP|PAYMENTS_SETUP)\\.md|vercel\\.json|package(?:-lock)?\\.json)$",
      "dest": "/api/not-found"
    },
    {
      "src": "^/api/health$",
      "dest": "/api/payments/availability?check=health"
    },
    {
      "src": "^/download$",
      "dest": "/downloads/SleepyMumla-v0.6.9.apk"
    },
    {
      "src": "^/downloads/VC-Mumla-Web-Join.apk$",
      "dest": "/downloads/SleepyMumla-v0.6.9.apk"
    },
    {
      "src": "^/$",
      "dest": "/home.html"
    },
    {
      "src": "^/join$",
      "dest": "/join.html"
    },
    {
      "src": "^/join/$",
      "dest": "/join.html"
    },
    {
      "src": "^/join/join.js$",
      "dest": "/join.js"
    },
    {
      "src": "^/install$",
      "dest": "/install.html"
    },
    {
      "src": "^/install/$",
      "dest": "/install.html"
    },
    {
      "src": "^/history/?$",
      "dest": "/history.html"
    },
    {
      "handle": "filesystem"
    }
  ],
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/payment-retention",
      "schedule": "0 18 * * *"
    }
  ]
}
