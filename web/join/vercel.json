{
  "functions": {
    "api/mcsv/install.js": {
      "maxDuration": 300
    }
  },
  "routes": [
    {
      "src": "^/(.*)$",
      "headers": {
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "^/downloads/VC-Mumla-Web-Join.apk$",
      "headers": {
        "Content-Type": "application/vnd.android.package-archive",
        "Content-Disposition": "attachment; filename=\"SleepyMumla.apk\""
      },
      "continue": true
    },
    {
      "src": "^/download$",
      "headers": {
        "Content-Type": "application/vnd.android.package-archive",
        "Content-Disposition": "attachment; filename=\"SleepyMumla.apk\""
      },
      "continue": true
    },
    {
      "src": "^/(?:lib(?:/.*)?|vercel\\.json|package(?:-lock)?\\.json)$",
      "dest": "/api/not-found"
    },
    {
      "src": "^/download$",
      "dest": "https://raw.githubusercontent.com/samsosleepy2007/VoiceChat-Mumble-MCSV/3f23d8da725e404c6afda5fbb56552a8264e7e6b/web/join/downloads/SleepyMumla-v0.6.2.apk"
    },
    {
      "src": "^/downloads/VC-Mumla-Web-Join.apk$",
      "dest": "https://raw.githubusercontent.com/samsosleepy2007/VoiceChat-Mumble-MCSV/3f23d8da725e404c6afda5fbb56552a8264e7e6b/web/join/downloads/SleepyMumla-v0.6.2.apk"
    },
    {
      "src": "^/$",
      "dest": "/home.html"
    },
    {
      "src": "^/join$",
      "dest": "/join.html"
    },
    {
      "src": "^/join/$",
      "dest": "/join.html"
    },
    {
      "src": "^/join/join.js$",
      "dest": "/join.js"
    },
    {
      "src": "^/install$",
      "dest": "/install.html"
    },
    {
      "src": "^/install/$",
      "dest": "/install.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
